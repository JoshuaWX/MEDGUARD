# Copy to ml/.env and fill in. ml/.env is git-ignored — NEVER commit real secrets.
#
# Only predict_and_write.py needs these (to upsert forecasts into Supabase).
# fetch_weather / build_dataset / train run fully offline without them.

SUPABASE_URL=https://cddfhyxlhtmrrtduwlqd.supabase.co

# Service-role key. Write-only use from a trusted machine / CI secret.
# Do NOT expose this in the Expo app or any EXPO_PUBLIC_* var.
SUPABASE_SERVICE_ROLE_KEY=
