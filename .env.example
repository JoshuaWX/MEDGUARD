## Example environment variables for local development
# Copy this to `.env.local` (or set real env vars) and fill in the values.
# Do NOT commit `.env.local` into version control. Keep your anon keys secret.

# For Vite (client-side) the env var must start with VITE_
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional server-side names (if you run the local Node server in server/proxy.js)
# Used for generating signed URLs securely. The SERVICE ROLE key must be kept secret.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# For Mobile Expo app (in mobile-expo/)
# Set these in your Expo environment or app.json extra config
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# For Flask chatbot (End-to-end-Medical-Chatbot-Generative-AI/)
# SECURITY: Keep debug disabled in production
FLASK_DEBUG=false
FLASK_SECRET_KEY=change-this-to-a-secure-random-string
