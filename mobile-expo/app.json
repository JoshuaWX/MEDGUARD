{
  "expo": {
    "name": "MedGuard",
    "slug": "medguard",
    "scheme": "medguard",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B7C8C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.medguard.ng",
      "buildNumber": "5",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "MedGuard uses your location to personalize health alerts and verify your state.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "If you opt in, MedGuard updates your health alert area while the app is closed.",
        "NSMotionUsageDescription": "MedGuard reads your step count only when you choose to connect all-day steps.",
        "NSCameraUsageDescription": "MedGuard uses the camera only when you choose to take a profile picture.",
        "NSPhotoLibraryUsageDescription": "MedGuard accesses your photos only when you choose a profile picture.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "allowBackup": false,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B7C8C"
      },
      "edgeToEdgeEnabled": true,
      "versionCode": 5,
      "predictiveBackGestureEnabled": false,
      "package": "com.medguard.ng",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "ACTIVITY_RECOGNITION",
        "POST_NOTIFICATIONS",
        "android.permission.health.READ_STEPS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            { "scheme": "medguard", "host": "signin" },
            { "scheme": "medguard", "host": "auth" },
            { "scheme": "medguard", "host": "google-auth" }
          ],
          "category": ["DEFAULT", "BROWSABLE"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MedGuard uses your location to personalize health alerts and verify your state.",
          "locationAlwaysAndWhenInUsePermission": "If you opt in, MedGuard updates your health alert area while the app is closed.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "MedGuard reads your step count only when you choose to connect all-day steps."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MedGuard accesses your photos only when you choose a profile picture.",
          "cameraPermission": "MedGuard uses the camera only when you choose to take a profile picture.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#11b4d4",
          "defaultChannel": "health-reminders"
        }
      ],
      [
        "@sentry/react-native",
        {
          "organization": "joshuawx",
          "project": "medguard",
          "url": "https://de.sentry.io/"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "./plugins/withHealthConnectPermissionDelegate"
    ],
    "extra": {
      "eas": {
        "projectId": "b1313581-bf13-4302-8456-ed9e2242d65e"
      }
    }
  }
}
