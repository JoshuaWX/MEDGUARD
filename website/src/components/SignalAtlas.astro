---
import atlas from '../data/nigeria-adm1.json';

const viewBox = { width: 760, height: 650, padding: 62 };
const bounds = atlas.bounds;
const width = bounds.maxX - bounds.minX;
const height = bounds.maxY - bounds.minY;
const scale = Math.min((viewBox.width - viewBox.padding * 2) / width, (viewBox.height - viewBox.padding * 2) / height);
const project = ([x, y]: number[]) => [
  viewBox.padding + (x - bounds.minX) * scale,
  viewBox.height - viewBox.padding - (y - bounds.minY) * scale,
];
const ringPath = (ring: number[][]) => ring.map((point, index) => {
  const [x, y] = project(point);
  return `${index === 0 ? 'M' : 'L'}${x.toFixed(2)} ${y.toFixed(2)}`;
}).join(' ') + 'Z';
const states = atlas.states.map((state) => ({ ...state, path: state.polygons.flatMap((polygon) => polygon.map(ringPath)).join(' '), point: project(state.centroid) }));
const initialState = states.find((state) => state.name === 'Kwara') ?? states[0];
type Placement = { x: number; y: number; width: number; height: number };
const overlaps = (candidate: Placement, placed: Placement[]) => placed.some((item) => candidate.x - candidate.width / 2 < item.x + item.width / 2 + 3 && candidate.x + candidate.width / 2 > item.x - item.width / 2 - 3 && candidate.y - candidate.height / 2 < item.y + item.height / 2 + 3 && candidate.y + candidate.height / 2 > item.y - item.height / 2 - 3);
const placed: Placement[] = [];
const offsets = [[0, -10], [0, 11], [14, -8], [-14, -8], [17, 10], [-17, 10], [28, -16], [-28, -16], [30, 17], [-30, 17], [45, 0], [-45, 0], [16, -30], [-16, -30], [20, 31], [-20, 31], [58, -23], [-58, -23], [60, 25], [-60, 25], [74, 0], [-74, 0], [0, -44], [0, 45]];
const labels = states.slice().sort((a, b) => a.point[1] - b.point[1]).map((state) => {
  const label = state.name.replace('Federal Capital Territory', 'FCT');
  const labelWidth = Math.max(16, label.length * 4.55 + 5);
  const [cx, cy] = state.point;
  let target = { x: cx, y: cy, width: labelWidth, height: 8 };
  for (const [dx, dy] of offsets) {
    const candidate = { x: Math.max(labelWidth / 2 + 4, Math.min(viewBox.width - labelWidth / 2 - 4, cx + dx)), y: Math.max(10, Math.min(viewBox.height - 10, cy + dy)), width: labelWidth, height: 8 };
    if (!overlaps(candidate, placed)) { target = candidate; break; }
  }
  placed.push(target);
  return { ...state, label, ...target, leader: Math.hypot(target.x - cx, target.y - cy) > 12 };
});
---

<section class="signal-atlas" data-signal-atlas data-atlas={JSON.stringify(atlas)} data-initial-state={initialState.id} aria-labelledby="atlas-title">
  <h2 class="sr-only" id="atlas-title">MedGuard Nigeria signal atlas</h2>
  <div class="signal-atlas__stage">
    <div class="signal-atlas__canvas" aria-hidden="true"></div>
    <div class="signal-atlas__poster">
      <svg viewBox={`0 0 ${viewBox.width} ${viewBox.height}`} role="img" aria-labelledby="atlas-map-title atlas-map-description">
        <title id="atlas-map-title">Nigeria, divided into its 36 states and Federal Capital Territory</title>
        <desc id="atlas-map-description">An illustrative MedGuard product atlas. Select a state to inspect its name. It does not contain live disease data.</desc>
        <defs><linearGradient id="atlas-land" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#147f8c" /><stop offset="1" stop-color="#075965" /></linearGradient></defs>
        <g class="signal-atlas__contours" aria-hidden="true"><path d="M 82 244 C 183 160, 323 151, 434 209 S 650 303, 696 221" /><path d="M 43 349 C 168 253, 343 253, 465 337 S 636 496, 713 385" /><path d="M 109 493 C 239 382, 423 407, 533 490 S 618 568, 699 533" /><path d="M 153 117 C 266 55, 430 72, 571 139" /></g>
        <g class="signal-atlas__states" data-poster-states>{states.map((state) => <path d={state.path} fill="url(#atlas-land)" data-poster-state={state.id} data-selected={state.id === initialState.id ? 'true' : 'false'} tabindex="0" role="button" aria-label={`${state.name}. Select this state.`} />)}</g>
      </svg>
      <svg class="signal-atlas__labels" viewBox={`0 0 ${viewBox.width} ${viewBox.height}`} aria-hidden="true">{labels.map((state) => <g data-atlas-label={state.id} data-selected={state.id === initialState.id ? 'true' : 'false'}>{state.leader && <line x1={state.point[0]} y1={state.point[1]} x2={state.x} y2={state.y} />}<text x={state.x} y={state.y} text-anchor="middle">{state.label}</text></g>)}</svg>
    </div>
    <p class="signal-atlas__caption">Illustrative product map · never live disease data</p>
  </div>
  <div class="signal-atlas__interface">
    <label class="signal-atlas__state-control" for="atlas-state"><span>Explore a state</span><select id="atlas-state" data-atlas-state>{states.map((state) => <option value={state.id} selected={state.id === initialState.id}>{state.name}</option>)}</select></label>
    <p class="signal-atlas__selected"><strong data-atlas-state-name>{initialState.name}</strong><span>Illustrative local view</span></p>
    <button class="signal-atlas__skip" type="button" data-atlas-skip>Use flat atlas</button>
    <a class="signal-atlas__source" href="https://www.geoboundaries.org/" target="_blank" rel="noreferrer">Boundary data: geoBoundaries gbOpen · CC BY 4.0</a>
  </div>
</section>

<script>
  type AtlasState = { id: string; name: string; centroid: number[]; polygons: number[][][][] };
  type Atlas = { bounds: { minX: number; minY: number; maxX: number; maxY: number }; states: AtlasState[] };
  const root = document.querySelector<HTMLElement>('[data-signal-atlas]');
  if (root) {
    const atlas = JSON.parse(root.dataset.atlas ?? '{}') as Atlas;
    const stateSelect = root.querySelector<HTMLSelectElement>('[data-atlas-state]');
    const posterStates = [...root.querySelectorAll<SVGPathElement>('[data-poster-state]')];
    const labels = [...root.querySelectorAll<SVGGElement>('[data-atlas-label]')];
    const stateName = root.querySelector<HTMLElement>('[data-atlas-state-name]');
    const canvasHost = root.querySelector<HTMLElement>('.signal-atlas__canvas');
    const skip = root.querySelector<HTMLButtonElement>('[data-atlas-skip]');
    const reducedQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    const desktopQuery = window.matchMedia('(min-width: 961px)');
    let selectedState = root.dataset.initialState ?? atlas.states[0]?.id;
    let selectSceneState: ((id: string) => void) | undefined;
    let stopScene: (() => void) | undefined;
    const chooseState = (id: string | undefined) => {
      const state = atlas.states.find((item) => item.id === id); if (!state) return;
      selectedState = state.id; if (stateName) stateName.textContent = state.name; if (stateSelect) stateSelect.value = state.id;
      posterStates.forEach((path) => path.setAttribute('data-selected', String(path.dataset.posterState === state.id)));
      labels.forEach((label) => label.setAttribute('data-selected', String(label.dataset.atlasLabel === state.id))); selectSceneState?.(state.id);
    };
    stateSelect?.addEventListener('change', () => chooseState(stateSelect.value));
    posterStates.forEach((path) => { path.addEventListener('pointerenter', () => chooseState(path.dataset.posterState)); path.addEventListener('click', () => chooseState(path.dataset.posterState)); path.addEventListener('focus', () => chooseState(path.dataset.posterState)); path.addEventListener('keydown', (event) => { if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); chooseState(path.dataset.posterState); } }); });
    const setStill = () => { root.classList.add('signal-atlas--still'); stopScene?.(); stopScene = undefined; };
    skip?.addEventListener('click', () => { setStill(); skip.hidden = true; });
    const memory = Number((navigator as Navigator & { deviceMemory?: number }).deviceMemory ?? 8);
    if (!canvasHost || reducedQuery.matches || !desktopQuery.matches || memory <= 2) setStill();
    else requestAnimationFrame(async () => {
      try {
        const THREE = await import('three'); if (root.classList.contains('signal-atlas--still')) return;
        const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true, powerPreference: 'low-power' }); renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.4)); renderer.outputColorSpace = THREE.SRGBColorSpace; renderer.domElement.setAttribute('aria-hidden', 'true'); canvasHost.appendChild(renderer.domElement);
        const scene = new THREE.Scene(); const camera = new THREE.PerspectiveCamera(31, 1, 0.1, 100); camera.position.set(0, -0.4, 11.1); const terrain = new THREE.Group(); terrain.rotation.set(-0.24, -0.08, -0.02); scene.add(terrain);
        const mapWidth = atlas.bounds.maxX - atlas.bounds.minX; const mapHeight = atlas.bounds.maxY - atlas.bounds.minY; const mapScale = 7.85 / Math.max(mapWidth, mapHeight); const cx = (atlas.bounds.minX + atlas.bounds.maxX) / 2; const cy = (atlas.bounds.minY + atlas.bounds.maxY) / 2; const point = ([x, y]: number[]) => new THREE.Vector2((x - cx) * mapScale, (y - cy) * mapScale); const materials = new Map<string, InstanceType<typeof THREE.MeshStandardMaterial>>();
        atlas.states.forEach((state) => { const material = new THREE.MeshStandardMaterial({ color: 0x09636e, roughness: 0.72, metalness: 0.05 }); materials.set(state.id, material); state.polygons.forEach((polygon) => { const outer = polygon[0]; if (!outer || outer.length < 4) return; const shape = new THREE.Shape(); outer.forEach((item, index) => { const p = point(item); index ? shape.lineTo(p.x, p.y) : shape.moveTo(p.x, p.y); }); shape.closePath(); const geometry = new THREE.ExtrudeGeometry(shape, { depth: 0.12, bevelEnabled: false, curveSegments: 1 }); terrain.add(new THREE.Mesh(geometry, material)); const edge = new THREE.LineSegments(new THREE.EdgesGeometry(geometry, 8), new THREE.LineBasicMaterial({ color: 0xa4eff1, transparent: true, opacity: 0.37 })); edge.position.z = 0.006; terrain.add(edge); }); });
        scene.add(new THREE.HemisphereLight(0xc4ffff, 0x02323a, 2.2)); const key = new THREE.DirectionalLight(0x7be7eb, 2.1); key.position.set(-3, 5, 7); scene.add(key);
        selectSceneState = (id) => materials.forEach((material, key) => { const active = key === id; material.color.set(active ? 0x0b8792 : 0x09636e); material.emissive.set(active ? 0x053a40 : 0x000000); material.emissiveIntensity = active ? 0.48 : 0; });
        const resize = () => { const rect = canvasHost.getBoundingClientRect(); camera.aspect = rect.width / Math.max(1, rect.height); camera.updateProjectionMatrix(); renderer.setSize(rect.width, rect.height, false); }; const resizeObserver = new ResizeObserver(resize); resizeObserver.observe(canvasHost); resize();
        let visible = true; let frame = 0; let targetY = -0.08; let targetX = -0.24; const onPointer = (event: PointerEvent) => { const rect = root.getBoundingClientRect(); targetY = -0.08 + ((event.clientX - rect.left) / rect.width - .5) * .13; targetX = -0.24 + ((event.clientY - rect.top) / rect.height - .5) * .06; }; root.addEventListener('pointermove', onPointer, { passive: true });
        const render = () => { frame = 0; if (!visible || document.hidden) return; terrain.rotation.y += (targetY - terrain.rotation.y) * .025; terrain.rotation.x += (targetX - terrain.rotation.x) * .025; renderer.render(scene, camera); frame = requestAnimationFrame(render); }; const resume = () => { if (visible && !document.hidden && !frame) frame = requestAnimationFrame(render); }; const observer = new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; visible ? resume() : (cancelAnimationFrame(frame), frame = 0); }, { threshold: .06 }); observer.observe(root); const visibility = () => document.hidden ? (cancelAnimationFrame(frame), frame = 0) : resume(); document.addEventListener('visibilitychange', visibility); const reduced = (event: MediaQueryListEvent) => { if (event.matches) setStill(); }; reducedQuery.addEventListener('change', reduced);
        stopScene = () => { cancelAnimationFrame(frame); resizeObserver.disconnect(); observer.disconnect(); document.removeEventListener('visibilitychange', visibility); reducedQuery.removeEventListener('change', reduced); scene.traverse((object) => { const mesh = object as InstanceType<typeof THREE.Mesh>; mesh.geometry?.dispose?.(); const materials = Array.isArray(mesh.material) ? mesh.material : [mesh.material]; materials.filter(Boolean).forEach((item) => item.dispose?.()); }); renderer.dispose(); renderer.domElement.remove(); };
        renderer.domElement.addEventListener('webglcontextlost', (event) => { event.preventDefault(); setStill(); }, { once: true }); root.classList.add('signal-atlas--ready'); chooseState(selectedState); resume();
      } catch { setStill(); }
    });
  }
</script>
