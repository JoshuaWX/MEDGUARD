{
  "$schema": "https://json.schemastore.org/package",
  "name": "medguard",
  "version": "1.0.0",
  "private": true,
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.4",
    "@types/node": "^20.3.1",
    "autoprefixer": "^10.4.14",
    "concurrently": "^9.2.1",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "node-fetch": "^2.7.0",
    "postcss": "^8.4.27",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.19.4",
    "typescript": "^5.4.2",
    "vite": "^7.1.11"
  },
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./dist/output.css --minify",
    "dev:css": "tailwindcss -i ./src/input.css -o ./dist/output.css --watch",
    "build:ts": "tsc --project tsconfig.json",
  "dev": "vite",
  "server": "node server/proxy.js",
  "dev:server": "node server/proxy.js",
  "dev:py": "cd End-to-end-Medical-Chatbot-Generative-AI && \"C:/Users/Admin/miniconda3/envs/medibot/python.exe\" app.py",
  "dev:all": "concurrently -k -n web,api -c blue,green \"npm:dev\" \"npm:dev:server\"",
  "dev:full": "concurrently -k -n web,css,api,chat -c blue,magenta,green,yellow \"npm:dev\" \"npm:dev:css\" \"npm:dev:server\" \"npm:dev:py\"",
    "rag:ingest": "tsx src/rag/ingest.ts",
    "rag:query": "tsx src/rag/query.ts",
    "build": "vite build && npm run build:css && npm run build:ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@langchain/community": "^0.3.33",
    "@langchain/core": "^0.3.45",
    "@langchain/openai": "^0.4.9",
    "@langchain/pinecone": "^0.1.3",
    "@pinecone-database/pinecone": "^6.1.1",
    "@supabase/supabase-js": "^2.31.0",
    "@xenova/transformers": "^2.17.2",
    "langchain": "^0.3.30",
    "pdf-parse": "^1.1.1"
  }
}
