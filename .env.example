## Example environment variables for local development
# Copy this to `.env.local` (or set real env vars) and fill in the values.
# Do NOT commit `.env.local` into version control. Keep your anon keys secret.

# For Vite (client-side) the env var must start with VITE_
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional server-side names (if you run a Node server)
SUPABASE_URL=
SUPABASE_KEY=
