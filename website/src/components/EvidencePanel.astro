---
const facts = [
  {
    value: '41%',
    label: 'of Nigerians used the internet in 2024.',
    note: 'Individuals using the internet · Nigeria · 2024',
    source: 'World Bank / ITU',
    href: 'https://data.worldbank.org/indicator/IT.NET.USER.ZS?locations=NG',
  },
  {
    value: '27%',
    label: 'smartphone ownership in Nigeria in 2024.',
    note: 'Smartphone ownership · Nigeria · 2024',
    source: 'GSMA',
    href: 'https://www.gsma.com/solutions-and-impact/connectivity-for-good/mobile-for-development/wp-content/uploads/2024/10/GSMA-Smartphone-Adoption-Report.pdf',
  },
  {
    value: '10,837',
    label: 'cholera cases reported by WHO in Nigeria during the first nine months of 2024.',
    note: '359 deaths · 35 states and FCT · 1 Jan–29 Sep 2024',
    source: 'WHO situation report',
    href: 'https://www.who.int/docs/default-source/coronaviruse/situation-reports/20241008_multi-country_outbreak-of-cholera_sitrep_19.pdf?download=true&sfvrsn=2b766537_3',
  },
];
---

<section class="evidence-panel" aria-labelledby="evidence-heading" data-story-reveal>
  <div class="evidence-panel__head">
    <div>
      <span class="eyebrow">Why this matters</span>
      <h3 id="evidence-heading">The access gap is part of the health problem.</h3>
    </div>
    <p>These are dated public-context facts—not MedGuard activity, forecasts or impact results.</p>
  </div>
  <ol class="evidence-panel__facts">
    {facts.map((fact) => (
      <li>
        <strong>{fact.value}</strong>
        <p>{fact.label}</p>
        <small>{fact.note}</small>
        <a href={fact.href} target="_blank" rel="noopener noreferrer">{fact.source}<span aria-hidden="true"> ↗</span></a>
      </li>
    ))}
  </ol>
  <details class="evidence-panel__sources">
    <summary>Sources and definitions</summary>
    <p>Internet use is the World Bank indicator for individuals using the internet. GSMA’s ownership figure is not the same measure as internet use. The WHO cholera figure is a historical situation-report total and is included only as public-health context; it is not a current alert or estimate.</p>
  </details>
</section>
