{
  "$schema": "https://json.schemastore.org/package",
  "name": "medguard",
  "version": "1.0.0",
  "private": true,
  "description": "Verification scripts for the MedGuard mobile, website, and Supabase application.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "mobile:start": "npm --prefix mobile-expo start",
    "mobile:android": "npm --prefix mobile-expo run android",
    "mobile:typecheck": "cd mobile-expo && npx tsc --noEmit",
    "mobile:test:contracts": "node --import tsx --test mobile-expo/scripts/runtime-contracts.test.ts",
    "edge:test:notifications": "node --import tsx --test supabase/functions/_shared/__tests__/*.test.ts",
    "edge:test:waitlist": "deno test supabase/functions/join-waitlist/validation.test.ts",
    "edge:check:waitlist": "deno check --node-modules-dir=auto --config supabase/functions/deno.json supabase/functions/join-waitlist/index.ts",
    "website:check": "npm --prefix website run check",
    "website:build": "npm --prefix website run build",
    "supabase:bundle:intel": "node scripts/build-intel-bundle.mjs",
    "supabase:test": "supabase test db",
    "verify": "npm run mobile:typecheck && npm run mobile:test:contracts && npm run edge:test:notifications && npm run edge:test:waitlist && npm run edge:check:waitlist && npm run website:build"
  },
  "devDependencies": {
    "@types/node": "^20.3.1",
    "deno": "^2.9.6",
    "supabase": "^2.105.0",
    "tsx": "^4.19.4",
    "typescript": "^5.4.2"
  }
}
